# syntax=docker/dockerfile:1
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Image for `e2e` jobs: the job image plus what Cypress needs to drive a browser
# headless. Built on the host from the local job image, so BASE names its tag.
#
# Cypress's own Electron needs GTK, NSS, ALSA and Xvfb. A suite that asks for
# `--browser chromium` also needs a Chromium on PATH, and Ubuntu 24.04 ships
# Chromium only as a snap, which does not run in a container. The browser here
# is the Chrome for Testing build Playwright publishes for linux-arm64 and
# linux-x64, pinned by version and SHA-256.

ARG BASE=heroiclands/ci-job:1
FROM ${BASE}

ARG TARGETARCH

ARG CHROMIUM_VERSION=153.0.8010.12
ARG CHROMIUM_SHA256_AMD64=8aac35011c18f6e2d10696154af89a5728ac2ddd6dc6fad24ffdf243c3fcfd5a
ARG CHROMIUM_SHA256_ARM64=7d8a4b4ff289efe44a06501a519df142c4c18fff7aaf1c1401a3fbb12b3bd069

USER root
SHELL ["/bin/bash", "-euo", "pipefail", "-c"]

# Cypress's documented Linux prerequisites, the libraries Chromium links
# against, and fonts so pages render text with real metrics.
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      xvfb xauth \
      libgtk-3-0t64 libgbm1 libnotify4 libnss3 libxss1 libasound2t64 libxtst6 \
      libatk-bridge2.0-0t64 libatk1.0-0t64 libatspi2.0-0t64 libcairo2 libcups2t64 \
      libdbus-1-3 libdrm2 libglib2.0-0t64 libnspr4 libpango-1.0-0 libx11-6 \
      libxcb1 libxcomposite1 libxdamage1 libxext6 libxfixes3 libxkbcommon0 \
      libxrandr2 \
      fonts-liberation fonts-noto-color-emoji fonts-freefont-ttf \
 && rm -rf /var/lib/apt/lists/*

RUN arch="${TARGETARCH:-$(dpkg --print-architecture)}"; \
    case "${arch}" in \
      amd64) cft=linux64;     sha="${CHROMIUM_SHA256_AMD64}" ;; \
      arm64) cft=linux-arm64; sha="${CHROMIUM_SHA256_ARM64}" ;; \
      *) echo "unsupported architecture: ${arch}" >&2; exit 1 ;; \
    esac; \
    work="$(mktemp -d)"; cd "${work}"; \
    curl --fail --silent --show-error --location --retry 5 --retry-delay 5 --retry-all-errors \
      -o chrome.zip "https://cdn.playwright.dev/builds/cft/${CHROMIUM_VERSION}/${cft}/chrome-${cft}.zip"; \
    echo "${sha}  chrome.zip" | sha256sum --check --status; \
    unzip -q chrome.zip; \
    mv "chrome-${cft}" /opt/chromium; \
    cd /; rm -rf "${work}"

# Cypress finds `--browser chromium` by running `chromium --version` and reading
# "Chromium <version>"; Chrome for Testing names itself otherwise. Every other
# invocation goes straight to the browser.
COPY --chmod=0755 <<'EOF' /usr/local/bin/chromium
#!/bin/sh
if [ "$#" -eq 1 ] && [ "$1" = "--version" ]; then
  version="$(/opt/chromium/chrome --version)"
  echo "Chromium ${version##* for Testing }"
  exit 0
fi
exec /opt/chromium/chrome "$@"
EOF

RUN chromium --version && /opt/chromium/chrome --version && Xvfb -help >/dev/null 2>&1 && docker --version

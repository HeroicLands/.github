value=$(git config --bool hooks.noAttribution 2>/dev/null) || value=
[ "$value" != false ] || exit 0

# Unicode decoration must not turn ordinary developer prose into a credit.
# Select a UTF-8 locale only within this hook process.
is_utf8() {
    case "$1" in
        UTF-8 | UTF8 | utf-8 | utf8) return 0 ;;
        *) return 1 ;;
    esac
}
charmap=$(locale charmap 2>/dev/null) || charmap=
if ! is_utf8 "$charmap"; then
    selected=
    for candidate in C.UTF-8 C.utf8 en_US.UTF-8 en_US.utf8 $(locale -a 2>/dev/null); do
        charmap=$(LC_ALL="$candidate" locale charmap 2>/dev/null) || charmap=
        if is_utf8 "$charmap"; then
            selected=$candidate
            break
        fi
    done
    if [ -z "$selected" ]; then
        printf '%s\n' 'commit-msg: error: a UTF-8 locale is required to check assistant credits.' \
            'Install or enable a UTF-8 locale (for example en_US.UTF-8) and commit again.' >&2
        exit 1
    fi
    LC_ALL=$selected
    export LC_ALL
fi

[ -r "$1" ] || { printf '%s: error: cannot read commit message\n' "$1" >&2; exit 1; }

# sed uses the locale character classes even when awk is byte-oriented.
# Keep line positions while ignoring Git comments and the verbose diff.
normalized=$(sed '
    /^#.*>8/,$s/.*//
    /^#/s/.*//
    :links
    s/\[\([^]][^]]*\)\]([^[:space:]                 　﻿)]*)/\1/g
    t links
    s/[*_`~]//g
    s/^[^[:alpha:]]*//
' "$1") || {
    printf '%s: error: cannot normalize commit message\n' "$1" >&2
    exit 1
}
printf '%s\n' "$normalized" | awk -v message_file="$1" '

# The finite JavaScript whitespace grammar is explicit because POSIX locale
# space classes differ. Keep whitespace inside identity names literal.
BEGIN {
    ws = "([ \t\r\n\v\f]| | | | | | | | | | | | | | | | | |　|﻿)"
}
function identity(value) {
    return value ~ /^(codex|chatgpt|openai|openai codex|openai chatgpt|claude|claude code|anthropic|github copilot|gemini|cursor|ai|ai assistant|an ai assistant)$/
}
function mailbox(value) {
    return value ~ /^(codex@openai[.]com|chatgpt@openai[.]com|noreply@openai[.]com|claude@anthropic[.]com|noreply@anthropic[.]com)$/
}
function trim(value) {
    sub("^" ws "+", "", value)
    sub(ws "+$", "", value)
    return value
}
{
    text = $0
    sub(/\r$/, "", text)
    text = tolower(trim(text))
    kind = ""
    if (text ~ /^co-authored-by:/) {
        name = text
        sub("^co-authored-by:" ws "*", "", name)
        email = ""
        if (match(name, /<[^<>]+>$/)) {
            email = substr(name, RSTART + 1, RLENGTH - 2)
            name = substr(name, 1, RSTART - 1)
        }
        if (identity(trim(name)) || mailbox(email)) kind = "Co-Authored-By trailer naming an assistant"
    }
    signature = text
    sub(/[.!]$/, "", signature)
    if (signature ~ "^(generated by|generated with|assisted by|written by)" ws "+") {
        sub("^(generated by|generated with|assisted by|written by)" ws "+", "", signature)
        if (identity(signature)) kind = "assistant signature"
    }
    generic = text
    sub(/[.!]$/, "", generic)
    if (generic ~ /^ai-(assisted|generated)$/) kind = "assistant signature"
    if (generic ~ "^ai-(assisted|generated)" ws "+(by|with)" ws "+") {
        sub("^ai-(assisted|generated)" ws "+(by|with)" ws "+", "", generic)
        if (identity(generic)) kind = "assistant signature"
    }
    if (kind != "") {
        printf "%s:%d: error: %s; remove the assistant credit and commit again.\n", message_file, NR, kind
        rejected = 1
    }
}
END { exit rejected ? 1 : 0 }
' >&2
